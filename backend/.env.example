# Server
PORT=3000
ALLOWED_ORIGIN=https://kai297097-cpu.github.io

# Flowise
# Either set this to your full prediction endpoint:
#   https://<your-flowise>.onrender.com/api/v1/prediction/<chatflow-id>
# OR set it to the base URL and also set FLOWISE_CHATFLOW_ID (optional, see server.js)
FLOWISE_API_URL=https://<your-flowise>.onrender.com

# Optional: only needed if FLOWISE_API_URL is NOT a full endpoint
FLOWISE_CHATFLOW_ID=<chatflow-id>

# Optional Basic Auth for Flowise (server-side only)
FLOWISE_USERNAME=
FLOWISE_PASSWORD=

